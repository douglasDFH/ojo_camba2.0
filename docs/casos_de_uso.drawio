        </mxCell>
        <mxCell id="CU-11" value="&lt;b&gt;CU-11 ? REQUISITO PENDIENTE&lt;/b&gt;&lt;br&gt;Crear en campo un Caso de Obra agrupando reportes duplicados cercanos. Requisito documentado; API actual restringida a Backoffice." style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#C57B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=13;spacing=10;" vertex="1" parent="1">
