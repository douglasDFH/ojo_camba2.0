          <mxGeometry x="990" y="565" width="490" height="95" as="geometry" />
        </mxCell>
        <mxCell id="CU-21" value="&lt;b&gt;CU-21&lt;/b&gt;&lt;br&gt;Asignar o reasignar una cuadrilla a un Caso de Obra y priorizar su atenci?n." style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#4A8DB8;fontSize=13;spacing=10;" vertex="1" parent="1">
