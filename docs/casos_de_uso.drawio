        <mxCell id="CU-25" value="&lt;b&gt;CU-25&lt;/b&gt;&lt;br&gt;Proponer el resultado de una visita con evidencia y destino/rechazo cuando aplique." style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#4C9A69;fontSize=13;spacing=10;" vertex="1" parent="1">
