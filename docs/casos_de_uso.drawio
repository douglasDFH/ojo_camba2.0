        <mxCell id="CU-24" value="&lt;b&gt;CU-24&lt;/b&gt;&lt;br&gt;Registrar la llegada a una visita con coordenadas GPS." style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#4C9A69;fontSize=13;spacing=10;" vertex="1" parent="1">
