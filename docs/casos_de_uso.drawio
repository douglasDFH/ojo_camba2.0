        <mxCell id="CU-12" value="&lt;b&gt;CU-12&lt;/b&gt;&lt;br&gt;Registrar avances con comentario, foto, recursos y fecha estimada, sin exigir cambio de estado." style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#4C9A69;fontSize=13;spacing=10;" vertex="1" parent="1">
