        <mxCell id="CU-27" value="&lt;b&gt;CU-27&lt;/b&gt;&lt;br&gt;Derivar un Caso de Obra a una entidad externa, con motivo y evidencia." style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#4C9A69;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="565" width="460" height="95" as="geometry" />
